# =====================================================================
# KAP Portal - Ortam Değişkenleri
# Bu dosyayı '.env' olarak kopyalayıp GEREKLİ bölümü doldurun.
# =====================================================================

# --- GEREKLİ (bunlar olmadan production'da uygulama açılmaz) ---
# Admin giriş şifresi. NODE_ENV=production iken boşsa app fail-fast ile
# crash olur (kasıtlı - production'a varsayılan şifreyle çıkılmasın diye).
ADMIN_PASS=
# JWT imzalama anahtarı, rastgele uzun bir string. Yine production'da
# boşsa crash olur. Üretmek için: openssl rand -hex 32
JWT_SECRET=

# =====================================================================
# Aşağıdakilerin hepsi OPSİYONEL - kodda zaten güvenli bir varsayılanı
# var, sadece farklı bir davranış istiyorsanız açıp değiştirin.
# =====================================================================

# --- Giriş / kullanıcılar ---
# ADMIN_USER=admin
# Salt okunur kullanıcı (Ana Panel / Veri İşleme menüde görünmez, sadece
# GET isteklerine izinli). İkisi de boşsa viewer girişi tamamen kapalı.
# VIEWER_USER=viewer
# VIEWER_PASS=
# JWT_EXPIRES_IN=8h
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_WINDOW_MS=900000

# --- MCP (Onyx bağlantısı) ---
# Onyx'in bu sunucuya hangi hostname/IP ile bağlanacağını buraya ekleyin;
# eşleşmeyen Host başlığı taşıyan istekler reddedilir. Yalnızca özel
# ağ/VPN içinden erişilecekse (public internete açık değilse) varsayılan
# genelde yeterlidir.
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,0.0.0.0
# Doldurulursa Onyx bu değeri Authorization: Bearer veya X-API-Key olarak
# göndermek zorunda kalır. Sadece özel ağ/VPN'de kalınacaksa gerek yok.
# MCP_API_KEY=
# Rating servisinin kendi MCP'si (8064) için aynı mantık; boşsa açık.
# RATING_MCP_API_KEY=

# --- İleri seviye / genelde dokunmanıza gerek yok ---
# Container image adı - Docker Hub'dan hazır image çekmek için
# docker-compose.deploy.yml kullanılıyorsa orada zaten kendi varsayılanı var.
# KAP_PORTAL_IMAGE=kapportal-mcp:local
# Sadece /api/health çıktısında görünen kozmetik bir etiket, davranışı
# etkilemez.
# APP_VERSION=dev
# Bir reverse proxy'nin ARKASINDAYSA (nginx, load balancer) req.ip'nin
# doğru gelmesi için Express'in trust proxy ayarı. Doğrudan erişimde boş
# bırakın.
# TRUST_PROXY=
# Tarayıcıdan (portal'ın kendi frontend'i DIŞINDA bir origin'den) API'ye
# istek atılacaksa gerekir; aynı origin'den servis edilen normal kurulumda
# gerek yok.
# PORTAL_ALLOWED_ORIGINS=
# MCP uç noktasına tarayıcıdan (Onyx'in backend'i değil, doğrudan
# JavaScript'ten) erişilecekse gerekir - normalde gerek yok.
# MCP_ALLOWED_ORIGINS=

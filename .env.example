# Container image and release label
KAP_PORTAL_IMAGE=memobaba44/kapportal-mcp:latest
APP_VERSION=1.0.0

# Network
BIND_ADDRESS=0.0.0.0
PRIMARY_DNS=1.1.1.1
SECONDARY_DNS=8.8.8.8
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,0.0.0.0,172.30.146.31
PORTAL_ALLOWED_ORIGINS=
MCP_ALLOWED_ORIGINS=
TRUST_PROXY=

# Portal login - change before the first company deployment
ADMIN_USER=admin
ADMIN_PASS=CHANGE_WITH_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=CHANGE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=8h
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MS=900000

# Optional. When set, Onyx must send this value as Bearer or X-API-Key.
MCP_API_KEY=

# Optional but recommended when port 8064 is reachable outside the Docker host.
# The portal proxy automatically uses the same key.
RATING_MCP_API_KEY=
